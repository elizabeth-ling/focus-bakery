.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Licensed art pack (Modern Interiors, LimeZu) - redistribution prohibited.
# Never commit these. See feature-specs/14-art-asset-pipeline.md.
/assets/

# Atlases sliced from that pack. The licence forbids distributing the asset
# "edited or not", so derived atlases are build artifacts, not commits.
# Regenerate: python3 tools/atlas/build_atlases.py
/Resources/*.atlas/

# ...except the font, which is not the pack. The pack ships no font at all
# (14), so FocusPixel is authored in this repo from tools/font/glyphs.py and
# carries none of LimeZu's pixels. Committing it keeps the app buildable
# without Python for anyone who only wants to run it.
!/Resources/Font.atlas/
